# Optional comma-separated HTTPS origins allowed for CMS image, document, and application links.
SFAU_TRUSTED_EXTERNAL_ORIGINS=
NEON_BRANCH=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_FUNCTION_HELLO_BASE_URL=
